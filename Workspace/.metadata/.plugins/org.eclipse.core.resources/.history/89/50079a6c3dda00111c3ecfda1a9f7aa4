void Board_Reset()
{
	Board_Charge_Disable();
	Board_Bleeder_Enable();
	Board_Status_Clear_Flag(BOARD_STATUS_OV_TRIP);
	Board_Status_Clear_Flag(BOARD_STATUS_I2C_LAST_REG_ERROR);
	Board_Status_Clear_Flag(BOARD_STATUS_I2C_LAST_VALUE_ERROR);
}

void Board_Charge_Enable()
{
	uint8_t ov_trip = Board_Status_Get_Flag(BOARD_STATUS_OV_TRIP);
	uint8_t fault = Board_Status_Get_Flag(BOARD_STATUS_FAULT);

//	if (!ov_trip && !fault)
	if (!ov_trip)
	{
	  Board_Bleeder_Disable();
	  HAL_GPIO_WritePin(OUT_ENABLE_GPIO_Port, OUT_ENABLE_Pin, GPIO_PIN_SET);
	  Board_Status_Set_Flag(BOARD_STATUS_CHARGE);
	}
}


void Board_Charge_Disable()
{
	HAL_GPIO_WritePin(OUT_ENABLE_GPIO_Port, OUT_ENABLE_Pin, GPIO_PIN_RESET);
	Board_Status_Clear_Flag(BOARD_STATUS_CHARGE);
	Board_FB_Idle();
}


void Board_Bleeder_Enable()
{
	Board_Charge_Disable();
	HAL_GPIO_WritePin(OUT_BLEEDER_GPIO_Port, OUT_BLEEDER_Pin, GPIO_PIN_SET);
	Board_Status_Set_Flag(BOARD_STATUS_BLEEDER);
}


void Board_Bleeder_Disable()
{
	HAL_GPIO_WritePin(OUT_BLEEDER_GPIO_Port, OUT_BLEEDER_Pin,  GPIO_PIN_RESET);
	Board_Status_Clear_Flag(BOARD_STATUS_BLEEDER);
}


void Board_Kick_Start()
{
	Board_Charge_Disable();
    kick_finished = 0;
    Board_Kick_Set_PWM(kick_duty);
    Board_Kick_Set_Pulse_Duration(kick_duration);
//    Board_Status_Set_Flag(BOARD_STATUS_KICK);
}


void Board_Kick_Stop()
{
	Board_Kick_Off();
	Board_Kick_Pulse_Stop();
//	Board_Status_Clear_Flag(BOARD_STATUS_KICK);
//	Board_Charge_Enable();
}


void Board_Kick_Off()
{
	Board_Kick_Set_PWM(0U);
	Board_Kick_Pulse_Stop();
//	Board_Status_Clear_Flag(BOARD_STATUS_KICK);
}


/*
 * Configura o TIM2 para gerar um PWM com um determinado duty.
 * PWM Modo 2 é invertido - CCR máximo é duty zero, e vice-versa.
 * Atualiza o CCR para o registrador ativo e limpa a flag de update.
 */
void Board_Kick_Set_PWM(uint16_t duty)
{
	/* Seta o registrador CCR */
	__HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_2, kick_pwm_ccr_max - duty);
	__HAL_TIM_SET_COUNTER(&htim2, 0);

	/* Atualiza o novo CCR para o registrador ativo no PWM*/
	HAL_TIM_GenerateEvent(&htim2, TIM_EVENTSOURCE_UPDATE);

	/* Limpa a tag de atualização, pois não querenmos tratá-la */
    __HAL_TIM_CLEAR_FLAG(&htim2, TIM_FLAG_UPDATE);
}

/*
 * Configura o TIM3 para gerar um pulso com a duracao do chute.
 */
void Board_Kick_Set_Pulse_Duration(uint16_t duration_ms)
{
   __HAL_TIM_SET_AUTORELOAD(&htim3, duration_ms - 1U);
   __HAL_TIM_SET_COUNTER(&htim3, 0);
   __HAL_TIM_CLEAR_FLAG(&htim3, TIM_FLAG_UPDATE);

   /* Inicia o TIM_3 (gerador de pulsos) */
   HAL_TIM_Base_Start_IT(&htim3);
}

/*
 * Força o stop do gerador de pulsos do kick
 */
void Board_Kick_Pulse_Stop()
{
	/*
	 * Interrompe o TIM_3 (gerador de pulsos)
	 * Zera o contador
	 * Limpa o flag de update
	 *
	 */
    HAL_TIM_Base_Stop_IT(&htim3);
    __HAL_TIM_SET_COUNTER(&htim3, 0);
    __HAL_TIM_CLEAR_FLAG(&htim3, TIM_FLAG_UPDATE);
}

void Board_FB_Calculate()
{
//  fb_duty = ((v_sec * PWM_FB_DUTY_SETPOINT) / v_sec_set);

//  fb_duty = ((v_sec * PWM_FB_DUTY_SETPOINT) / v_sec_set) / 2;

	fb_duty = 500;


  if (fb_duty > PWM_FB_DUTY_MAX)
  {
	  fb_duty = PWM_FB_DUTY_MAX;
  }
  __HAL_TIM_SET_COMPARE(&htim14, TIM_CHANNEL_1, fb_duty);

  /* Atualiza o novo CCR para o registrador ativo no PWM*/
	HAL_TIM_GenerateEvent(&htim14, TIM_EVENTSOURCE_UPDATE);

	/* Limpa a tag de atualização, pois não querenmos tratá-la */
  __HAL_TIM_CLEAR_FLAG(&htim14, TIM_FLAG_UPDATE);

}


void Board_FB_Idle()
{
	fb_duty = PWM_FB_DUTY_MAX;
	__HAL_TIM_SET_COMPARE(&htim14, TIM_CHANNEL_1, fb_duty);
}


void Board_Status_Set_Flag(uint8_t flag_mask)
{
	board_status |= flag_mask;
}

void Board_Status_Clear_Flag(uint8_t flag_mask)
{
	board_status &= ~flag_mask;
}

uint8_t Board_Status_Get_Flag(uint8_t flag_mask)
{
  return ((board_status & flag_mask) != 0U);
}


void Board_Vsec_Calculate()
{
  v_sec = (adc_raw_vcap * 3300U) / 4095U;
}

void Board_OV_Trip_Verify()
{
  if (v_sec > V_SEC_MAX &&
		  Board_Status_Get_Flag(BOARD_STATUS_OV_TRIP) == 0U
		  )
  {
	  /* Ativa o trip por tensao alta */
	  Board_Status_Set_Flag(BOARD_STATUS_OV_TRIP);
  }
}


