void HAL_I2C_AddrCallback(
		I2C_HandleTypeDef *hi2c,
		uint8_t transfer_direction,
		uint16_t addr_match_code
		)
{
	if (hi2c->Instance != I2C1)
	{
		return;
	}

	/* Master quer gravar no slave.
	 * Byte seguinte sera o indice do registrador
	 */
	if (transfer_direction == I2C_DIRECTION_TRANSMIT)
	{
		rx_bytes_count = 0;
		HAL_I2C_Slave_Seq_Receive_IT(hi2c, &rx_byte, 1, I2C_FIRST_AND_NEXT_FRAME);
	}

	/* Master quer ler no slave. */
	else if (transfer_direction == I2C_DIRECTION_RECEIVE)
	{
		uint16_t value = 0;

		if (reg_index <= read_reg_count)
		{
			value = *read_registers[reg_index];
		}

		tx_buffer[0] = value >> 8;		// Byte alto, deslocado 8 bits para direita
		tx_buffer[1] = value & 0xFF; 	// Byte baixo, considerando somente 8 bits da direita

		HAL_I2C_Slave_Seq_Transmit_IT(hi2c, tx_buffer, 2, I2C_FIRST_AND_LAST_FRAME);
	}
}



void HAL_I2C_SlaveRxCpltCallback(I2C_HandleTypeDef *hi2c)
{
    if (hi2c->Instance != I2C1)
        return;

    // Primeiro byte: indice do registrador
    if (rx_bytes_count == 0)
    {
        reg_index = rx_byte;
    }

    // Segundo byte: byte alto
    else if (rx_bytes_count == 1)
    {
        value_msb = rx_byte;
    }

    // Terceiro byte: byte baixo; grava o uint16_t completo
    else if (rx_bytes_count == 2)
    {
        value_lsb = rx_byte;

		has_update = 1;
		reg_to_update = reg_index;
		value_to_update = ((uint16_t)value_msb << 8) | value_lsb;
    }

    rx_bytes_count++;

    // Após receber os três bytes, volta a esperar uma nova escrita.
    if (rx_bytes_count >= 3)
    {
        rx_bytes_count = 0;
    }

    HAL_I2C_Slave_Seq_Receive_IT(hi2c, &rx_byte, 1,
                                 I2C_NEXT_FRAME);
}


void HAL_I2C_ListenCpltCallback(I2C_HandleTypeDef *hi2c)
{
    if (hi2c->Instance != I2C1)
        return;

    HAL_I2C_EnableListen_IT(hi2c);
}


void HAL_GPIO_EXTI_Rising_Callback(uint16_t GPIO_Pin)
{
	if (GPIO_Pin == EXTI_FAULT_Pin)
	{
		Board_Status_Clear_Flag(BOARD_STATUS_FAULT);
	}
	else if (GPIO_Pin == EXTI_DONE_Pin)
	{
		Board_Status_Clear_Flag(BOARD_STATUS_DONE);
	}
}


void HAL_GPIO_EXTI_Falling_Callback(uint16_t GPIO_Pin)
{
	if (GPIO_Pin == EXTI_FAULT_Pin)
	{
		Board_Status_Set_Flag(BOARD_STATUS_FAULT);
	}
	else if (GPIO_Pin == EXTI_DONE_Pin)
	{
		Board_Status_Set_Flag(BOARD_STATUS_DONE);
	}
}


void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM3)
    {
        kick_finished = 1;
        Board_Kick_Stop();
    }
}



