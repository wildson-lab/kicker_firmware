/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_I2C1_Init();
  MX_ADC1_Init();
  MX_TIM2_Init();
  MX_TIM3_Init();
  MX_TIM14_Init();
  /* USER CODE BEGIN 2 */

  if (HAL_ADCEx_Calibration_Start(&hadc1) != HAL_OK)
  {
      Error_Handler();
  }

  HAL_ADC_Start_DMA(&hadc1, (uint32_t *)&adc_raw_vcap, 1);
  __HAL_DMA_DISABLE_IT(&hdma_adc1, DMA_IT_HT);
  __HAL_DMA_DISABLE_IT(&hdma_adc1, DMA_IT_TC);

  HAL_I2C_EnableListen_IT(&hi2c1);

  __HAL_TIM_SET_COMPARE(&htim14, TIM_CHANNEL_1, 0);
  HAL_TIM_PWM_Start(&htim14, TIM_CHANNEL_1);

  __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_2, 0);
  HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_2);

  kick_pwm_ccr_max = __HAL_TIM_GET_AUTORELOAD(&htim2) + 1;

  kick_duration = 50;
  kick_duty = 500;
  v_sec_set = 500;

//	HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	  Board_Vsec_Calculate();
	  Board_FB_Calculate();
	  Board_OV_Trip_Verify();

	  fault_pin_low =
	      (HAL_GPIO_ReadPin(GPIOA, EXTI_FAULT_Pin) == GPIO_PIN_RESET);

	  /* Trip por tensao alta
	   * Desabilita a carga e descarrega os capacitores pelo bleeder
	   */
	  if (Board_Status_Get_Flag(BOARD_STATUS_OV_TRIP))
	  {
		  if (Board_Status_Get_Flag(BOARD_STATUS_CHARGE))
		  {
			  Board_Charge_Disable();
		  }
		  Board_Bleeder_Enable();
	  }

	  /* Atuacao do fault ou done
	   * Apenas desabilita o carregamento
	   */

	  /*
	  if (Board_Status_Get_Flag(BOARD_STATUS_DONE)  ||
		  Board_Status_Get_Flag(BOARD_STATUS_FAULT)
		  )
	  {
		  if (Board_Status_Get_Flag(BOARD_STATUS_CHARGE))
		  {
			  Board_Charge_Disable();
		  }
	  }
	  */

	  /* Situacao normal
	   * Gera o sinal de feedback
	   */

	  if (Board_Status_Get_Flag(BOARD_STATUS_CHARGE))
	  {

	  }


	  if (has_update)
	  {
		  has_update = 0;

		  switch(reg_to_update)
		  {
		  	  case (REG_VSEC_SET):
				  if (value_to_update >= 0 && value_to_update <= V_SEC_SET_MAX)
				  {
					  v_sec_set = value_to_update;
				  }
				  else
				  {
					  board_status |= BOARD_STATUS_I2C_LAST_VALUE_ERROR;				/* Seta o flag de erro de valor I2c */
				  }
		  	  break;
		  	  case (REG_KICK_DURATION):
				  if (value_to_update >= KICK_DURATION_MIN && value_to_update <= KICK_DURATION_MAX)
				  {
					  kick_duration = value_to_update;
				  }
				  else
				  {
					  board_status |= BOARD_STATUS_I2C_LAST_VALUE_ERROR;				/* Seta o flag de erro de valor I2c */
				  }
		  	  break;
		  	  case (REG_KICK_DUTY):
				  if (value_to_update >= KICK_DUTY_MIN && value_to_update <= KICK_DUTY_MAX)
				  {
					  kick_duty = value_to_update;
				  }
				  else
				  {
					  board_status |= BOARD_STATUS_I2C_LAST_VALUE_ERROR;				/* Seta o flag de erro de valor I2c */
				  }
		  	  break;


		  	  case (REG_KICK_START):
				  if (value_to_update == COMMAND_START)
				  {
					  if (!(board_status & BOARD_STATUS_KICK))
					  {
						  Board_Kick_Start();
					  }
				  }
				  else if (value_to_update == COMMAND_STOP)
				  {
					  if (board_status & BOARD_STATUS_KICK)
					  {
						  Board_Kick_Stop();
					  }
				  }
				  else
				  {
					  board_status |= BOARD_STATUS_I2C_LAST_VALUE_ERROR;				/* Seta o flag de erro de valor I2c */
				  }
		  	  break;


		  	  case (REG_CHARGE_ENABLE):
				  if (value_to_update == COMMAND_START)
				  {
					  if (!(board_status & BOARD_STATUS_CHARGE))
					  {
						  Board_Charge_Enable();
					  }
				  }
				  else if (value_to_update == COMMAND_STOP)
				  {
					  if (board_status & BOARD_STATUS_CHARGE)
					  {
						  Board_Charge_Disable();
					  }
				  }
				  else
				  {
					  board_status |= BOARD_STATUS_I2C_LAST_VALUE_ERROR;				/* Seta o flag de erro de valor I2c */
				  }
		  	  break;

		  	  case (REG_BLEEDER_ENABLE):
				  if (value_to_update == COMMAND_START)
				  {
					  if (!(board_status & BOARD_STATUS_BLEEDER))
					  {
						  Board_Bleeder_Enable();
					  }
				  }
				  else if (value_to_update == COMMAND_STOP)
				  {
					  if (board_status & BOARD_STATUS_BLEEDER)
					  {
						  Board_Bleeder_Disable();
					  }
				  }
				  else
				  {
					  board_status |= BOARD_STATUS_I2C_LAST_VALUE_ERROR;				/* Seta o flag de erro de valor I2c */
				  }
		  	  break;

		  	  default:
		  		  board_status |= BOARD_STATUS_I2C_LAST_REG_ERROR;				/* Seta o flag de erro de registrador I2c */
              break;

		  }

	  }

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

